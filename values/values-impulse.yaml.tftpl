config:
  env:
    LOG_LEVEL: "DEBUG"
impulseConfig:
  incident:
    notifications:
      new_firing: false
  messenger:
    type: "telegram"
    # URL of Impulse instance for button callbacks. HTTPS — TLS включён через cert-manager + Let's Encrypt.
    impulse_address: "https://impulse.${lb_ip}.sslip.io"
    admin_users: ["telegram_admin_id"]
    users:
      telegram_admin_id:
        id: "${telegram_admin_id}"
      team_a_teamlead:
        id: "${telegram_teamlead_id}"
      # Дежурный техподдержки — последняя ступень эскалации: тегается через
      # 5 минут после teamlead, если никто не нажал Take It. Тегается в ТОМ ЖЕ
      # чате инцидента (incidents_team_a), отдельного чата техподдержки нет —
      # Impulse не умеет создавать инцидент в другом канале из schedule-chain
      # (шага channel нет, шаг user постит в текущий чат).
      support_oncall:
        id: "${telegram_support_oncall_id}"
      # Дежурный: teamlead и devops-инженер — один человек. В будни 09:00–20:00
      # дежурный тегается сразу, далее через 5 минут — teamlead, ещё через 5
      # минут — support_oncall.
      team_a_oncall:
        id: "${telegram_admin_id}"
    channels:
      incidents_team_a:
        id: "${telegram_chat_id}"
    chains:
      # Schedule-chain: будни 09:00–20:00 (Asia/Omsk) — чат → тег дежурного
      # сразу → wait 5m → тег teamlead → wait 5m → тег support_oncall (дежурный
      # техподдержки). Вне этого окна (будни 20:00–09:00 и выходные) — чат →
      # wait 5m → тег teamlead → wait 5m → тег support_oncall. support_oncall —
      # последняя ступень, тегается в текущем чате инцидента, если teamlead
      # не нажал Take It в течение 5 минут. Матчеры оцениваются сверху вниз,
      # первый совпавший выбирает steps. Ветка без matcher (последняя) —
      # fallback. support_escalation — общая schedule-chain техподдержки
      # (24/7, одна fallback-ветка), вызывается через шаг chain после teamlead.
      support_escalation:
        # Вложенная schedule-chain дежурного техподдержки — 24/7, без
        # матчеров (одна fallback-ветка). Тегает support_oncall в текущем
        # чате инцидента. Вызывается как шаг `chain: support_escalation`
        # в team_a_escalation после teamlead.
        type: schedule
        timezone: Asia/Omsk
        schedule:
          - steps:
              - user: support_oncall
      team_a_escalation:
        type: schedule
        timezone: Asia/Omsk
        schedule:
          - matcher:
              start_day_expr: dow
              start_day_values: ["Mon", "Tue", "Wed", "Thu", "Fri"]
              start_time: "09:00"
              duration: 11h
            steps:
              - user: team_a_oncall
              - wait: 5m
              - user: team_a_teamlead
              - wait: 5m
              - chain: support_escalation
          - steps:
              - wait: 5m
              - user: team_a_teamlead
              - wait: 5m
              - chain: support_escalation
  route:
    channel: "incidents_team_a"
    chain: "team_a_escalation"

secrets:
  existing:
    telegram:
      secretName: "impulse-telegram-secrets"
      botTokenKey: "bot-token"
ingress:
  enabled: true
  className: nginx
  annotations:
    kubernetes.io/ingress.class: nginx
    cert-manager.io/cluster-issuer: letsencrypt-prod
    kubernetes.io/tls-acme: "true"
  hosts:
    - host: impulse.${lb_ip}.sslip.io
      paths:
        - path: /
          pathType: ImplementationSpecific
  tls:
    - secretName: impulse-tls
      hosts:
        - impulse.${lb_ip}.sslip.io
