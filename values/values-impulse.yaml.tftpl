config:
  env:
    LOG_LEVEL: "DEBUG"
impulseConfig:
  incident:
    notifications:
      new_firing: false
  messenger:
    type: "telegram"
    # URL of Impulse instance for button callbacks. Telegram Bot API requires HTTPS,
    # but TLS is currently disabled (see AGENTS.md). Enable cert-manager + TLS before production use.
    impulse_address: "http://impulse.${lb_ip}.sslip.io"
    admin_users: ["admin_user"]
    users:
      admin_user:
        id: "telegram_user_id"
    channels:
      incidents_default:
        id: "telegram_chat_id"

  route:
    channel: "incidents_default"

secrets:
  existing:
    telegram:
      secretName: "impulse-telegram-secrets"
      botTokenKey: "bot-token"
ingress:
  enabled: true
  className: nginx
  annotations:
    kubernetes.io/ingress.class: nginx
  hosts:
    - host: impulse.${lb_ip}.sslip.io
      paths:
        - path: /
          pathType: ImplementationSpecific
